# =========== Database ===========
POSTGRES_USER=irss_admin
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=irss_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# =========== Redis ===========
REDIS_URL=redis://redis:6379/0

# =========== MinIO (S3-compatible) ===========
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_in_production
MINIO_BUCKET_NAME=irss-resumes
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=localhost:9001

# =========== JWT AUTH ===========
JWT_SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# =========== Ollama ===========
OLLAMA_BASE_URL=http://ollama:11434
MODEL_PARSE=mistral:7b-instruct-q4_K_M
MODEL_EXPLAIN=llama3.1:8b-instruct-q4_K_M
MODEL_EMBED=nomic-embed-text

# =========== LLM Defaults ===========
LLM_TEMPERATURE=0.7
LLM_TOP_P=0.95
LLM_MAX_TOKENS=2048

# =========== API ===========
API_HOST=0.0.0.0
API_PORT=8000
API_TITLE=IRSS Open Source
API_VERSION=2.0
ENVIRONMENT=production

# =========== CORS ===========
ALLOWED_ORIGINS=http://localhost:3000,http://frontend:3000,https://localhost

# =========== Celery ===========
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# =========== Logging ===========
LOG_LEVEL=INFO

# =========== Feature Flags ===========
ENABLE_OBSERVABILITY=true
ENABLE_MINIO=true
ENABLE_OLLAMA_FALLBACK=true

# =========== OpenTelemetry ===========
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_SERVICE_NAME=irss-api

# =========== Development ===========
DEBUG=false
RELOAD=false
